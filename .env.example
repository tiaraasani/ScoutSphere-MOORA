#--------------------------------------------------------------------
# ScoutSphere environment configuration
#
# Copy this file to `.env` and fill in the values for your server.
# `.env` is ignored by git and must never be committed.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Use `production` on every public server. `development` shows detailed
# error pages and SQL queries in the browser and must never be public.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://your-domain.example/'

# HTTPS is enforced automatically in production. Only disable it when
# TLS is terminated by a proxy that cannot forward the scheme.
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#
# Create a dedicated MySQL user with only the privileges the app needs:
#   CREATE USER 'pramuka_app'@'127.0.0.1' IDENTIFIED BY '<strong password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON pramuka_si.* TO 'pramuka_app'@'127.0.0.1';
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = pramuka_si
database.default.username = pramuka_app
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# INITIAL ADMIN USER
#
# Read once by `php spark db:seed AdminUserSeeder`. Remove both values
# after the account has been created.
#--------------------------------------------------------------------

ADMIN_USERNAME = admin
ADMIN_PASSWORD =
